# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed so
# that anyone cloning the repo knows exactly which knobs exist.
# ---------------------------------------------------------------------------

# --- Required for answer generation (ingestion/retrieval work without it) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Generation ---
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Embeddings (local, free, no API calls) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_ENABLED=true

# --- Vector store ---
# persistent = embedded on-disk Chroma (local dev / CI)
# http       = the chromadb container from docker-compose
CHROMA_MODE=persistent
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=careergraph_profile

# --- Retrieval ---
RETRIEVAL_TOP_K=5
# Cosine-similarity floor. Raise it to make the Q&A agent refuse more readily.
RETRIEVAL_MIN_SCORE=0.25
JD_RETRIEVAL_TOP_K=12

# --- Chunking ---
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# --- Service ---
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
